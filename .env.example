# ============================================================================
# 生图工作台 .env 配置模板
#
# 用法：把本文件复制一份、重命名为 .env，放在 image-gen-platform.exe 同目录，
#       下面「方案一 / 方案二」二选一，把要用的行开头的 # 删掉即可。
#
# 注意：什么都不配置时，程序默认按 MySQL 尝试连接 127.0.0.1 / root / 无密码。
# ============================================================================


# ── 方案一：SQLite（推荐，免装数据库，单文件随程序走）───────────────────────
# 只打开这一行就行：数据库文件自动生成在程序目录 data/platform.db，
# 不需要填主机、账号、密码。
#DB_BACKEND=sqlite


# ── 方案二：MySQL（本机装了 MySQL，或连远程数据库服务端）──────────────────
# 按实际环境填写；主机可以是 127.0.0.1，也可以是远程服务器 IP。
#DB_BACKEND=mysql
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_USER=root
#DB_PASSWORD=你的数据库密码
#DB_NAME=image_gen_platform
#TEST_DB_NAME=image_gen_platform_test


# ── 可选项：不配置就走默认值，一般不用动 ─────────────────────────────────
# 生成图片的输出目录（默认 exe 旁边的 outputs）
#OUTPUT_DIR=outputs
# 数据/上传素材目录（默认 exe 旁边的 data，素材库存放在 data/libraries/ 下）
#DATA_DIR=data
# 单个源站的并发任务上限（默认 2）
#MAX_CONCURRENT_TASKS=2
# 网页服务端口（默认 8765，端口被占用时改这里）
#APP_PORT=8765
